{
  "schemaVersion": 1,
  "id": "io.github.guiestrela.weather",
  "name": "Better Weather",
  "version": "1.0.0",
  "author": "Guiestrela",
  "description": "Weather pill with detail popup",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Better Weather",
    "description": "Weather pill with detail popup",
    "category": "Info",
    "allowMultiple": false,
    "settingsForm": "weatherSettings",
    "defaults": {
      "unit": "auto",
      "windUnit": "auto",
      "refreshMinutes": 15
    },
    "schema": [
      {
        "key": "unit",
        "type": "enum",
        "label": "Temperature unit",
        "options": [
          {
            "value": "auto",
            "label": "System default"
          },
          {
            "value": "metric",
            "label": "Celsius (°C)"
          },
          {
            "value": "imperial",
            "label": "Fahrenheit (°F)"
          }
        ],
        "defaultValue": "auto",
        "description": "Use the system default, Celsius (°C), or Fahrenheit (°F)."
      },
      {
        "key": "windUnit",
        "type": "enum",
        "label": "Wind speed unit",
        "options": [
          {
            "value": "auto",
            "label": "Follow temperature unit"
          },
          {
            "value": "kmh",
            "label": "Kilometers per hour (km/h)"
          },
          {
            "value": "mph",
            "label": "Miles per hour (mph)"
          },
          {
            "value": "ms",
            "label": "Meters per second (m/s)"
          },
          {
            "value": "kn",
            "label": "Knots (kn)"
          },
          {
            "value": "bf",
            "label": "Beaufort (Bft)"
          }
        ],
        "defaultValue": "auto",
        "description": "Choose km/h, mph, m/s, knots, or the Beaufort scale, independent of the temperature unit."
      },
      {
        "key": "refreshMinutes",
        "type": "integer",
        "label": "Refresh interval (minutes)",
        "min": 1,
        "max": 120,
        "step": 1,
        "defaultValue": 15
      }
    ]
  }
}
